{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gdb 调试当前文件",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "关闭美化打印，避免 MinGW gdb 报错",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "intel 汇编风格",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C: 编译当前文件"
    }
  ]
}
